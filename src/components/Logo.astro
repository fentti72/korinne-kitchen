---
// Korinne's Kitchen logo: a scored loaf over a baseline, the wordmark, and the tagline.
// "inline" sits in the header (mark beside the words); "stacked" is the full lockup.
import { site } from '../site';

interface Props {
  variant?: 'inline' | 'stacked';
  tagline?: boolean;
}

// The tagline mentions classes, so it hides while classes are switched off.
const { variant = 'inline', tagline = site.features.classes } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`]}>
  <svg class="logo__mark" viewBox="0 0 64 48" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 38V27a19 19 0 0 1 38 0v11Z"></path>
      <path d="M18 24.5q4-4 8 0M28 20.5q4-4 8 0M38 24.5q4-4 8 0"></path>
      <path d="M7 43.5h50"></path>
    </g>
  </svg>
  <span class="logo__words">
    <span class="logo__name">{site.name}</span>
    {tagline && <span class="logo__tagline">Classes &amp; small-batch baking</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--logo-text);
  }

  .logo__mark {
    color: var(--logo-mark);
    width: 2.4rem;
    height: auto;
    flex: none;
  }

  .logo__words {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .logo__name {
    font: 500 0.95rem/1.1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo__tagline {
    font: 400 0.72rem/1.2 var(--font-mono);
    color: var(--logo-mark);
    white-space: nowrap;
  }

  /* Header: the tagline only where there's room for it. */
  @media (max-width: 639px) {
    .logo--inline .logo__tagline {
      display: none;
    }
  }

  .logo--stacked {
    flex-direction: column;
    gap: 0.9rem;
    text-align: center;
  }

  .logo--stacked .logo__mark {
    width: 3.6rem;
  }

  .logo--stacked .logo__words {
    align-items: center;
    gap: 0.6rem;
  }

  .logo--stacked .logo__name {
    font-size: clamp(1.15rem, 4.5vw, 1.6rem);
    letter-spacing: 0.18em;
  }

  .logo--stacked .logo__tagline {
    font-size: clamp(0.85rem, 3vw, 1rem);
  }
</style>
