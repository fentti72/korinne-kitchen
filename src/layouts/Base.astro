---
import '../styles/global.css';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Hide the footer signup on pages that already have one in the body. */
  footerSignup?: boolean;
}

const { title, description = site.tagline, footerSignup = true } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.area.label}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const shareImage = new URL('/images/brand/og-image.png', Astro.site);
// The logo's own proportions (from its SVG viewBox), so the page reserves the right space before it loads.
const LOGO = { src: '/images/brand/korinnes-kitchen-logo.svg', width: 546, height: 255 };
// One-line version for the header (built from the logo's own shapes, laid out per Korinne's reference).
const LOGO_WIDE = { src: '/images/brand/korinnes-kitchen-logo-horizontal.svg', width: 1017, height: 146 };
const COOKIE = { src: '/images/brand/korinnes-kitchen-cookie.svg', width: 100, height: 100 };

// Business structured data: area only, never a street address.
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.tagline,
  url: Astro.site?.toString(),
  logo: new URL('/images/brand/korinnes-kitchen-logo.png', Astro.site).toString(),
  image: shareImage.toString(),
  founder: { '@type': 'Person', name: site.chef },
  areaServed: { '@type': 'City', name: `${site.area.city}, ${site.area.region}` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.area.city,
    addressRegion: site.area.region,
    addressCountry: site.area.country,
  },
  ...(site.instagram ? { sameAs: [`https://instagram.com/${site.instagram}`] } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Keep the site out of search results until launch: set SITE_LIVE=true in Netlify when it's ready. */}
    {import.meta.env.SITE_LIVE !== 'true' && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Korinne's Kitchen logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F7F1E8" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <img class="brand__logo" src={LOGO_WIDE.src} alt={site.name} width={LOGO_WIDE.width} height={LOGO_WIDE.height} />
        </a>
        <details class="menu">
          <summary>Menu</summary>
          <nav aria-label="Main">
            <ul>
              {
                site.nav.map((item) => (
                  <li class:list={['nav-item', { 'nav-item--parent': 'children' in item }]}>
                    <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                    {'children' in item && (
                      <>
                        <button
                          class="sub-toggle"
                          type="button"
                          aria-expanded="false"
                          aria-controls={`sub-${item.label}`}
                          aria-label={`${item.label} categories`}
                        >
                          <svg viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                            <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </button>
                        <ul class="sub" id={`sub-${item.label}`}>
                          {item.children?.map((child) => (
                            <li>
                              <a href={child.href} aria-current={path === child.href ? 'page' : undefined}>
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {footerSignup && <NewsletterSignup />}
        <a class="site-footer__logo" href="/">
          <img src={COOKIE.src} alt={site.name} width={COOKIE.width} height={COOKIE.height} loading="lazy" />
        </a>
        <p class="site-footer__meta">
          {site.name} · {site.area.label}
          {(site.features.classes || site.features.bake) && (
            <>
              {' · '}
              <a href="/policies/">Policies</a>
            </>
          )}
          {site.instagram && (
            <>
              {' · '}
              <a href={`https://instagram.com/${site.instagram}`}>Instagram</a>
            </>
          )}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: var(--gutter);
    top: 8px;
    z-index: 10;
    background: var(--surface);
    color: var(--link-on-surface);
    padding: 0.5em 1em;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  /* The logo takes whatever room the menu leaves, up to a cap; height follows its proportions. */
  .brand {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    margin-right: 1.25rem;
    padding: 0.75rem 0;
  }

  .brand__logo {
    display: block;
    width: 100%;
    max-width: 270px;
    height: auto;
  }

  @media (min-width: 900px) {
    .brand__logo {
      max-width: 400px;
    }
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    padding: 0.6rem 0;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1rem;
  }

  .menu a {
    display: block;
    padding: 0.7rem 0;
    color: var(--text);
    text-decoration: none;
    font-size: 1.1rem;
  }

  .menu a[aria-current='page'] {
    color: var(--link);
    font-weight: 600;
  }

  /* Phones: categories sit indented under their parent; no toggle needed. */
  .menu .sub {
    padding: 0 0 0.25rem 1rem;
    border-left: 2px solid var(--line);
    margin-left: 0.25rem;
  }

  .menu .sub a {
    padding: 0.5rem 0;
    font-size: 1rem;
    color: var(--text-muted);
  }

  .menu .sub a[aria-current='page'] {
    color: var(--link);
  }

  .sub-toggle {
    display: none;
  }

  /* Desktop: always-visible inline nav, with a dropdown under items that have categories. */
  @media (min-width: 900px) {
    .menu summary {
      display: none;
    }

    .menu nav {
      position: static;
      border: 0;
      background: none;
    }

    .menu ul {
      display: flex;
      gap: 1.4rem;
      padding: 0;
    }

    .menu a {
      font-size: 0.95rem;
    }

    .nav-item--parent {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.15rem;
    }

    .sub-toggle {
      display: grid;
      place-items: center;
      width: 24px;
      height: 32px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--text);
      cursor: pointer;
    }

    .sub-toggle svg {
      width: 10px;
      transition: transform 0.15s;
    }

    .menu .sub {
      position: absolute;
      top: 100%;
      left: -1rem;
      z-index: 6;
      display: none;
      flex-direction: column;
      gap: 0;
      min-width: 12rem;
      margin: 0;
      padding: 0.5rem 0;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg);
      box-shadow: 0 8px 24px rgb(46 36 32 / 0.12); /* espresso */
    }

    .menu .sub a {
      padding: 0.55rem 1rem;
      font-size: 0.95rem;
      color: var(--text);
    }

    .menu .sub a:hover {
      background: var(--surface);
    }

    /* Open on hover, when the arrow button is pressed, or while keyboard focus is inside the list. */
    .nav-item--parent:hover .sub,
    .nav-item--parent.is-open .sub,
    .menu .sub:focus-within {
      display: flex;
    }

    .nav-item--parent:hover .sub-toggle svg,
    .nav-item--parent.is-open .sub-toggle svg {
      transform: rotate(180deg);
    }
  }

  .site-footer {
    margin-top: 4rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
  }

  .site-footer__logo {
    display: flex;
    justify-content: center;
    margin: 3rem auto 0;
    width: fit-content;
  }

  .site-footer__logo img {
    display: block;
    height: 80px;
    width: auto;
  }

  .site-footer__meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 1.5rem;
    text-align: center;
  }
</style>

<script>
  // On desktop, the details element must be open so the inline nav shows.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 900px)');
  const sync = () => menu && (menu.open = mq.matches);
  sync();
  mq.addEventListener('change', sync);

  // Dropdown arrow buttons: toggle on click, close on Escape or a click elsewhere.
  document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((btn) => {
    const item = btn.closest('.nav-item--parent')!;
    const setOpen = (open: boolean) => {
      item.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => setOpen(!item.classList.contains('is-open')));
    item.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) setOpen(false);
    });
  });
</script>
