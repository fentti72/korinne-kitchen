---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import NextStep from '../components/NextStep.astro';
import { site } from '../site';
import portrait from '../assets/photos/about-portrait-standing.jpg';
import graduation from '../assets/photos/about-graduation.jpg';
import cake from '../assets/photos/about-chocolate-cake.jpg';
---

<Base title="About Me" description={`Korinne is a home based cook and baker in ${site.area.label}. Good food is her love language.`}>
  <section class="wrap hero">
    <div class="hero__text">
      <p class="eyebrow">About me</p>
      <h1>Hi, I'm {site.chef}.</h1>
      <p class="lede">
        I'm a home based cook and baker located in Flower Mound, Texas. Good food is my love language! I keep my
        KitchenAids busy, my sink full of dishes, and my taste buds happy. I share my favorite recipes as well as the
        things I'm learning in hopes to bring good food to the world. After all – good food is good life. Welcome to my
        Kitchen!
      </p>
    </div>
    <div class="hero__photo">
      <Photo
        src={portrait}
        alt="Korinne smiling, hand on her hip, in a dark green T-shirt"
        placeholder="Korinne"
        ratio={4 / 5}
        loading="eager"
        sizes="(min-width: 860px) 40vw, 100vw"
      />
    </div>
  </section>

  <section class="wrap section chapter">
    <div class="chapter__photo">
      <Photo
        src={graduation}
        alt="Korinne in chef whites receiving her culinary school certificate from an instructor"
        placeholder="Graduation"
        ratio={4 / 5}
        sizes="(min-width: 860px) 45vw, 100vw"
      />
    </div>
    <div class="chapter__text">
      <h2>My background</h2>
      <p>
        I grew up baking cookies on Sunday nights, learning to bake bread, and experimenting with recipes. My love of food
        stayed with me as a hobby until I decided to seek more training.
      </p>
      <p>
        I graduated with a professional certificate in the culinary arts from the Park City Culinary Institute in Summer of 2026 which taught me a ton and I'm always learning
        more!
      </p>
    </div>
  </section>

  <section class="dark beliefs-band">
    <div class="wrap beliefs">
    <div>
      <h2>Things I don't believe in</h2>
      <ul>
        <li>Making you scroll through my life story to get to a recipe</li>
        <li>Over complications</li>
        <li>Secret recipes</li>
      </ul>
    </div>
    <div>
      <h2>Things I do believe in</h2>
      <ul>
        <li>Gooey cookies</li>
        <li>Jesus Christ</li>
        <li>Good food makes a good life <span role="img" aria-label="smiley face">🙂</span></li>
      </ul>
    </div>
    </div>
  </section>

  <div class="wrap cta-wrap">
  <section class="cta surface" aria-labelledby="cta-heading">
    <div class="cta__photo">
      <Photo
        src={cake}
        alt="Korinne holding a tall chocolate layer cake topped with truffles and toffee"
        placeholder="Korinne with a cake"
        ratio={4 / 5}
        sizes="(min-width: 760px) 30vw, 100vw"
      />
    </div>
    <div>
      {
        site.features.classes || site.features.bake ? (
          <>
            <h2 id="cta-heading">Come cook with me</h2>
            <p class="muted">The best way to get to know me is in the kitchen. Classes are small and fill up fast.</p>
            <div class="cta__actions">
              {site.features.classes && <a class="btn" href="/classes/">Book a class</a>}
              {site.features.bake && <a class="btn btn--ghost" href="/bake/">Order this week's bake</a>}
            </div>
          </>
        ) : (
          <>
            <h2 id="cta-heading">Cook along with me</h2>
            <p class="muted">See what I'm making this week, or start with one of my favorite recipes.</p>
            <div class="cta__actions">
              <a class="btn" href="/recipes/">See my recipes</a>
              <a class="btn btn--ghost" href="/how-to/">Explore How-To</a>
            </div>
          </>
        )
      }
    </div>
  </section>
  </div>

  <div class="wrap section">
    <NextStep heading="Coming up" />
  </div>
</Base>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-top: clamp(2rem, 7vw, 5rem);
  }

  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 3fr 2fr;
      gap: 4rem;
    }
  }

  .lede {
    font-size: 1.25rem;
    max-width: var(--measure);
  }

  .hero__photo,
  .chapter__photo,
  .cta__photo {
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (max-width: 859px) {
    .hero__photo {
      order: -1;
    }
  }

  .chapter {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .chapter {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .chapter__text p {
    max-width: var(--measure);
    font-size: 1.1rem;
  }

  .beliefs-band {
    padding-block: var(--space-section);
  }

  .beliefs {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 760px) {
    .beliefs {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .beliefs ul {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 1.1rem;
  }

  .beliefs li + li {
    margin-top: 0.6rem;
  }

  /* Lighter sage: the main accent is too dark to see on espresso. */
  .beliefs li::marker {
    color: var(--color-sage);
  }

  .cta {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .cta-wrap {
    margin-top: var(--space-section);
  }

  @media (min-width: 760px) {
    .cta {
      grid-template-columns: 1fr 2fr;
      gap: 3rem;
    }
  }

  .cta__photo {
    max-width: 22rem;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
