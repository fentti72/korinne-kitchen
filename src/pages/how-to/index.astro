---
import Base from '../../layouts/Base.astro';
import PostFeed from '../../components/PostFeed.astro';
import { getPosts, getAllTags } from '../../lib/content';

const posts = await getPosts();
const allTags = getAllTags(posts);
---

<Base title="How-To" description="What Korinne is cooking, testing, and learning this week.">
  <div class="wrap">
    <header class="intro">
      <p class="eyebrow">How-To</p>
      <h1>What's on my stove</h1>
      <p class="muted lede">Short notes on what I'm cooking, testing, and learning, newest first.</p>
    </header>
    <PostFeed posts={posts} allTags={allTags} />
  </div>
</Base>

<style>
  .intro {
    padding: clamp(2.5rem, 8vw, 5rem) 0 1.5rem;
  }

  .lede {
    font-size: 1.15rem;
    max-width: var(--measure);
  }
</style>
