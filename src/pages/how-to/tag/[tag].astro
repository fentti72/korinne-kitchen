---
import Base from '../../../layouts/Base.astro';
import PostFeed from '../../../components/PostFeed.astro';
import { getPosts, getAllTags } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getAllTags(posts).map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)), allTags: getAllTags(posts) },
  }));
}

const { tag, posts, allTags } = Astro.props;
---

<Base title={`How-To: ${tag}`} description={`Korinne's how-to posts about ${tag}.`}>
  <div class="wrap">
    <header class="intro">
      <p class="eyebrow"><a href="/how-to/">How-To</a></p>
      <h1>Notes on {tag}</h1>
    </header>
    <PostFeed posts={posts} allTags={allTags} activeTag={tag} />
  </div>
</Base>

<style>
  .intro {
    padding: clamp(2.5rem, 8vw, 5rem) 0 1.5rem;
  }
</style>
