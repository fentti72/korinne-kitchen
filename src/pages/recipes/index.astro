---
import Base from '../../layouts/Base.astro';
import RecipeList from '../../components/RecipeList.astro';
import { getRecipes } from '../../lib/content';

const recipes = await getRecipes();
---

<Base title="My Favorite Recipes" description="Korinne's favorite recipes to cook and bake at home.">
  <header class="wrap intro">
    <p class="eyebrow">Recipes</p>
    <h1>My favorite recipes</h1>
    <p class="muted lede">The things I make again and again at home. Scale them to your table and print them for the kitchen.</p>
  </header>

  <RecipeList recipes={recipes} />
</Base>

<style>
  .intro {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    padding-bottom: clamp(1.5rem, 4vw, 2rem);
  }

  .lede {
    font-size: 1.15rem;
    max-width: var(--measure);
  }
</style>
